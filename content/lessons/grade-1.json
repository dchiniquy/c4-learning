        "id": "g1-sound-boxes-1",
        "type": "offline-task",
        "mode": "offline",
        "leadBy": "parent",
        "title": "Push a counter for each sound",
        "minutes": 10,
        "materials": [
          "paper with three or four boxes drawn",
          "counters"
        ],
        "parentPrompts": [
          "Say a word slowly, like \"ship\". Push one counter into a box for each sound: sh-i-p is three sounds.",
          "Say the sounds again while touching each box, then blend them back into the word.",
          "Try words with four sounds, like \"stop\" or \"chin\"."
        ]
      }
    ]
