  {
    "id": "g1-tens-ones",
    "grade": "1",
    "subject": "math",
    "unit": "g1-unit-1",
    "title": "Bundles of ten",
    "version": 1,
    "skillIds": [
      "g1-tens-ones"
    ],
    "activities": [
      {
        "id": "g1-tens-ones-1",
        "type": "offline-task",
        "mode": "offline",
        "leadBy": "parent",
        "title": "Bundle straws into tens",
        "minutes": 15,
        "materials": [
          "30 straws or craft sticks",
          "rubber bands"
        ],
        "parentPrompts": [
          "Count out 23 straws. Bundle ten at a time with a rubber band.",
          "Ask: \"How many bundles of ten? How many extra ones? So 23 is 2 tens and 3 ones.\"",
          "Say a number like 14 or 31 and have them build it with bundles and single straws."
        ]
      }
    ]
  },
