      {
        "id": "g1-make-ten-hands",
        "type": "offline-task",
        "mode": "offline",
        "leadBy": "parent",
        "title": "Ten-frame with counters",
        "minutes": 15,
        "materials": [
          "ten-frame drawn on paper",
          "20 counters (two colors)"
        ],
        "parentPrompts": [
          "Show 8 counters in the ten-frame. Ask: \"How many more to make 10?\"",
          "Try 9 + 5: move 1 counter to fill the ten, then say \"10 and 4 more is 14.\"",
          "Have them explain how they moved the counters before writing the equation."
        ]
      }
    ]
